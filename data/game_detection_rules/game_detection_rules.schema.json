{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TuiHub game detection rules",
  "type": "object",
  "properties": {
    "traversal": {
      "type": "object",
      "properties": {
        "skipDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "skipDirectories"
      ],
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "ignoreEntries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "genericStems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "ignoreEntries",
        "genericStems"
      ],
      "additionalProperties": false
    },
    "storeManifests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifest"
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/engine"
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hint"
      }
    }
  },
  "required": [
    "traversal",
    "defaults",
    "storeManifests",
    "engines",
    "hints"
  ],
  "additionalProperties": false,
  "$defs": {
    "probe": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/probe"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "magic": {
              "type": "string",
              "pattern": "^(?:[0-9a-fA-F]{2})+$"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "magic"
          ],
          "additionalProperties": false
        }
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "extension": {
                    "const": "none"
                  }
                },
                "required": [
                  "path",
                  "extension"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          }
        },
        "companions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          }
        },
        "titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/title"
          }
        }
      },
      "required": [
        "id",
        "entries"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "layouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layout"
          },
          "minItems": 1
        },
        "ignoreEntries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "genericStems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stripStemSuffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "layouts"
      ],
      "additionalProperties": false
    },
    "title": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "path",
            "line"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "kind",
            "path",
            "pointer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ini"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "path",
            "section",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "html-title"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "line",
                  "json",
                  "ini",
                  "html-title"
                ]
              }
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "manifest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "gog-galaxy-info"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "store": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id",
            "store",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "gog-galaxy-info"
                ]
              }
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "store": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id",
            "store"
          ]
        }
      ]
    },
    "hint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "uint-line"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "kind",
            "id",
            "provider",
            "paths"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "not": {
                "enum": [
                  "uint-line"
                ]
              }
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id",
            "provider"
          ]
        }
      ]
    }
  }
}
